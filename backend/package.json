{
  "name": "bill-backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply bill-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bill-db --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.110.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "workerd@1.20261006.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
