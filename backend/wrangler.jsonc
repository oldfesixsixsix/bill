{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bill-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bill-db",
      "database_id": "local-only-placeholder-fill-in-after-wrangler-d1-create"
    }
  ],
  // Fill these in with real values from the Cloudflare Access app once it's created
  // (issue #12, deployment). Never add DEV_MODE here — that only belongs in .dev.vars.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "CHANGE_ME.cloudflareaccess.com",
    "ACCESS_AUD": "CHANGE_ME"
  }
  // "compatibility_flags": [
