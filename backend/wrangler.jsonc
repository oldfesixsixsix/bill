{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bill-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bill-db",
      "database_id": "31687590-cf09-40c4-937a-dd31f34a3e19"
    }
  ],
  // Same-origin with the Pages frontend (ADR-0004): this Worker only answers
  // bill.unclereal.com/api/*, everything else on that host falls through to Pages.
  "routes": [
    {
      "pattern": "bill.unclereal.com/api/*",
      "zone_name": "unclereal.com"
    }
  ],
  // Fill these in with real values from the Cloudflare Access app once it's created.
  // Never add DEV_MODE here — that only belongs in .dev.vars.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "CHANGE_ME.cloudflareaccess.com",
    "ACCESS_AUD": "CHANGE_ME"
  }
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "kv_namespaces": [
