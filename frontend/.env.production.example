# Copy to .env.production.local (gitignored — *.local) and fill in the real
# value after the backend is deployed (see /docs/deployment.md). Picked up by
# `vite build` automatically; local dev doesn't need this (Vite's dev proxy
# handles /api instead).
VITE_API_BASE_URL=https://bill-backend.<your-subdomain>.workers.dev
